{
  "name": "diffora",
  "version": "0.1.0",
  "description": "Read-only local Git review in your terminal",
  "type": "module",
  "bin": {
    "diffora": "dist/cli.js",
    "terminal-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "integrations",
    "docs",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import ./scripts/test-locale.mjs --import tsx --test test/*.test.ts",
    "test:terminal": "npm run build && python3 scripts/terminal-smoke.py",
    "test:workflow": "npm run build && python3 scripts/workflow-smoke.py",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ink": "7.0.6",
    "react": "19.2.4",
    "sharp": "0.35.4",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "author": "JoseMLuzu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseMLuzu/diffora.git"
  },
  "homepage": "https://github.com/JoseMLuzu/diffora#readme",
  "bugs": {
    "url": "https://github.com/JoseMLuzu/diffora/issues"
  },
  "keywords": [
    "git",
    "diff",
    "review",
    "terminal",
    "tui",
    "ink"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
